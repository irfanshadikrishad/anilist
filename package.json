{
  "name": "@irfanshadikrishad/anilist",
  "description": "Minimalist unofficial AniList CLI for Anime and Manga Enthusiasts",
  "version": "1.9.11",
  "author": "Irfan Shadik Rishad",
  "license": "MPL-2.0",
  "scripts": {
    "all": "npm run build && npm run lint && npm run lint:fix && npm run format && npm test",
    "build": "rm -rf ./bin && tsc",
    "build:watch": "rm -rf ./bin && tsc -w",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint ./dist",
    "lint:fix": "eslint ./dist --fix",
    "prepare": "husky",
    "pretest": "npm run build",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest ./tests --runInBand"
  },
  "keywords": [
    "anilist",
    "CLI",
    "anime",
    "manga",
    "anime list",
    "manga list",
    "anime tracker",
    "manga tracker",
    "anilist API",
    "anime progress",
    "manga progress",
    "media list",
    "export anime",
    "import anime",
    "export manga",
    "import manga",
    "status tracker",
    "watchlist",
    "reading list",
    "graphql"
  ],
  "homepage": "https://github.com/irfanshadikrishad/anilist",
  "bugs": {
    "url": "https://github.com/irfanshadikrishad/anilist/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/irfanshadikrishad/anilist"
  },
  "type": "module",
  "main": "./bin/index.js",
  "types": "./bin/index.d.ts",
  "bin": {
    "anilist": "./bin/index.js"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "prettier": "@irfanshadikrishad/prettier",
  "dependencies": {
    "@irfanshadikrishad/cipher": "^1.7.1",
    "chalk": "^6.0.1",
    "cli-truncate": "^6.1.1",
    "commander": "^14.0.3",
    "fast-xml-parser": "^5.11.2",
    "inquirer": "^13.4.3",
    "jsonrepair": "^3.15.0",
    "open": "^11.0.4",
    "papaparse": "^5.7.0",
    "tiny-spinner": "^2.0.5"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@irfanshadikrishad/prettier": "^1.3.9",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.9",
    "@types/papaparse": "^5.5.2",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
